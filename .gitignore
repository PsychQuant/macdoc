# Build artifacts
.build/
.swiftpm/
DerivedData/

# Package resolved (optional - can include or exclude)
# Package.resolved

# Xcode
*.xcodeproj
*.xcworkspace
xcuserdata/

# macOS
.DS_Store

# VS Code
*.code-workspace

# Local packages & MCP (separate git repos)
#
# packages/* is a single-level glob: it only matches packages/<pkg> itself,
# never anything below it. Once a package directory is re-included with
# `!packages/<pkg>/`, git recurses into it and everything below is tracked
# by default — no per-file/per-subdirectory `!` exception is needed, or has
# any effect, inside an already-opened package (#191). The generic .build/,
# .swiftpm/, DerivedData/, .DS_Store rules above still apply at any depth,
# so build artifacts stay ignored without extra rules here.
#
# Do NOT widen a line to `!packages/<pkg>/**` — that unconditionally
# re-includes everything below the package root, including .build/ etc.,
# for any package that doesn't ship its own nested .gitignore.
#
# New package that should be tracked: add one line, `!packages/<new-pkg>/`.
# Package that stays local-only: add no line; packages/* keeps it ignored.
packages/*
!packages/bib-apa-swift/
!packages/bib-apa-to-html-swift/
!packages/bib-apa-to-json-swift/
!packages/bib-apa-to-md-swift/
!packages/biblatex-apa-swift/
!packages/docx-workflow-swift/
!packages/html-to-md-swift/
!packages/html-to-word-swift/
!packages/marker-word-converter-swift/
!packages/md-to-html-swift/
!packages/md-to-word-swift/
!packages/pdf-to-docx-swift/
!packages/pdf-to-md-swift/
!packages/srt-to-html-swift/
!packages/tex-to-docx-swift/
!packages/token-counter-swift/
!packages/word-to-html-swift/
# Every local `swift test` inside a package writes its Package.resolved; for a
# library package that is a build artifact, not source. token-counter-swift
# tracks its own on purpose (it pins a third-party fork by revision).
packages/*/Package.resolved
!packages/token-counter-swift/Package.resolved

# Local test files (personal .note, .pptx, .docx etc.)
test-files/

# Temp files
.tmp/
.tmp_*
.remember/tmp/
.claude/.idd/

# Reference repos (clone-on-demand; only README.md + textutil manpage are tracked)
reference/*
!reference/README.md
!reference/textutil-manpage.txt

# Local CLI experiments (separate git repos, same pattern as packages/)
# FastOCR graduated to a submodule (PsychQuant/FastOCR) — keep it un-ignored
cli/*
!cli/FastOCR
.spectra/
openspec/.vector-search.db*

# Plugin-scoped binary cache (#117) — downloaded MCP binaries + version sidecars
plugins/.bin-cache/
plugins/*/.bin-cache/

# IDD parallel worktree isolation (idd-worktree.sh #167) — not tracked in main tree
.claude/worktrees/
